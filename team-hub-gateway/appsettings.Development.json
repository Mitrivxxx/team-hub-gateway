{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7172",
        "Certificate": {
          "Path": "../../../certs/localhost.pem",
          "KeyPath": "../../../certs/localhost-key.pem"
        }
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5101/"
          }
        }
      }
    }
  }
}
