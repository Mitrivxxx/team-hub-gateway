{
  "Observability": {
    "ServiceName": "team-hub-gateway",
    "OtlpEndpoint": "http://mon-otel:4317"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "Properties": {
      "Application": "team-hub-gateway"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://mon-otel:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "team-hub-gateway"
          }
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "InvitePermitLimit": 5,
    "InviteAcceptPermitLimit": 10,
    "ImportPermitLimit": 3,
    "AvatarPermitLimit": 10,
    "SensitiveWindowSeconds": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://srv-auth:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      },
      "team-cluster": {
        "Destinations": {
          "team": {
            "Address": "http://srv-organization:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://srv-notification:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      },
      "chat-cluster": {
        "Destinations": {
          "chat": {
            "Address": "http://srv-chat:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      },
      "bff-cluster": {
        "Destinations": {
          "bff": {
            "Address": "http://srv-bff:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      }
    }
  }
}
