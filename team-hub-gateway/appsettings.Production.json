{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://+:8080",
        "Certificate": {
          "Path": "/https/localhost.pem",
          "KeyPath": "/https/localhost-key.pem"
        }
      }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00"
        }
      }
    }
  }
}
